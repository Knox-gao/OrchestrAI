 "humanInterventions": [],
 "plan": {
  "concept": "「破茧之前」——整个页面是一只正在缓慢孵化数字生命的茧：三件作品是茧内三个呼吸的器官，访客的每一次触碰都在参与孵化。",
  "identity": "页面以丝质纤维线条 + 生物荧光流体为统一视觉母题；三件作品共享'有机程序化'美学但使用完全不同的生成算法（纤维噪点流场 / 元胞自动菌落 / WebGL 折光茧体），加上贯穿全站的'孵化进度'叙事，形成策展人过目即记的独立辨识度。",
  "narrative": "弧线：静默的茧（入口氛围）→ 第一道裂缝：感知（噪声流场作品）→ 第二道裂缝：生长（元胞菌落作品）→ 第三道裂缝：蜕变（三维茧体作品）→ 破壳：邀约与联系。以'孵化'隐喻数字生命从算法中诞生，收束到策展邀约。",
  "tech": {
   "primary": "原生 Canvas 2D（两件作品）+ 裸 WebGL（一件作品）+ CSS/IntersectionObserver 驱动的全站动效，零依赖单文件",
   "why": "Canvas 2D 足以承载流场与元胞两类算法且性能可靠；WebGL shader 提供 2D 无法实现的折光/体感质感，体现技术纵深；无外部库保证任何环境直接可运行，也呼应艺术家'手写算法'的创作姿态。"
  },
  "scenes": [
   {
    "id": "scene-cocoon",
    "name": "茧 · 序幕",
    "content": "全屏标题「茧 COCOON」与副题「破茧之前——数字生命孵化中」。底部滚动提示：'向下滚动，参与孵化'。",
    "visual": "深色背景上，Canvas 绘制一枚由数百条贝塞尔丝线缠绕而成的茧形，丝线随时间极缓慢蠕动；中心透出微弱呼吸光晕（呼吸周期约 4 秒）。",
    "interaction": "鼠标/手指划过时丝线产生涟漪式扰动并微微加速蠕动；页面监测访客滚动与交互次数，实际累计为全站可见的'孵化进度百分比'（显示于右上角），后续各幕裂开均依赖真实进度。",
    "mobile": "茧居中缩放至视口 70%，触摸拖拽同样产生扰动；右上角进度徽标缩小为纯数字。"
   },
   {
    "id": "scene-field",
    "name": "第一道裂缝 · 《感知 (Perceive)》",
    "content": "标题、创作说明（关于'粒子沿感知场巡游，每一次注视都是一次喂养'）、技术署名'perlin 流场 · 4000 粒子 · 每帧实时计算'。",
    "visual": "Canvas 2D：数千尘埃状粒子沿 Perlin 噪声流场漂移，形成发光的神经丝状纹理，暖橙荧光色，丝线拖尾。作品的'裂缝框'由序幕丝线开裂效果衔接进入。",
    "interaction": "指针位置成为一个'感知源'：粒子在指针周围改变流场方向、聚拢又散开，如生物对触碰的趋性；点击切换两种场模式（自由漂移 / 有序漩涡），说明文案同步更新描述当前模式。",
    "mobile": "粒子数按设备像素比自动降至 1500；触摸即感知源；模式切换为作品下方按钮。"
   },
   {
    "id": "scene-colony",
    "name": "第二道裂缝 · 《生长 (Grow)》",
    "content": "标题、创作说明（关于'规则极简，形态无穷：细胞只懂三条规则，却长成策展人也未见的图样'）、实时计数'第 N 代 · 活体细胞 M'。",
    "visual": "Canvas 2D：类 Game of Life 的高分辨率元胞自动菌落，青绿荧光细胞在网格上生长、繁殖、凋亡，边缘细胞带柔和辉光；画幅呈圆形'培养皿'构图，与流场作品的横向撕裂构图形成对比。",
    "interaction": "点击/触摸培养皿任意处播种细胞团，菌落从此处重新演化；提供三个'环境'按钮（贫瘠/温润/肥沃），改变存活规则阈值，观者可亲历形态剧变；代数与活细胞计数实时更新。",
    "mobile": "培养皿全宽，触摸播种；环境按钮横排三个圆角按钮，触控目标 ≥44px。"
   },
   {
