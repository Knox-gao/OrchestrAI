{
  "schemaVersion": "orchestrai.pageplan.v1",
  "meta": {
    "title": "果冻海岛 · 高细节构图评估夹具",
    "description": "用于评估复合场景构图、自动取景、地形层次、植被聚落和真实浏览器视觉质量的桌面 WebGL 测试夹具；不是已验收的生产截图。",
    "language": "zh-CN"
  },
  "userConstraints": {
    "styleId": "neumorph-blossom",
    "fontMood": "serif",
    "pageDirection": "explore",
    "locked": true
  },
  "designIntent": {
    "concept": "参考用户提供的目标效果图，构建一座有明确海岸轮廓、分层地形、聚落、灯塔、植被、路径与海面层次的粉色果冻质感小岛。此夹具仅提供更丰富的结构数据，最后视觉质量必须通过 Edge 截图与人工对照验收。",
    "pageDirection": "explore",
    "visualPrinciples": [
      "目标参考图是视觉验收的来源，不得只凭 WebGL ready 或对象数量判断质量",
      "以明确可辨识的岛屿轮廓为第一层级，避免呈现为行星轨道图或无语义球体集合",
      "通过沙岸/礁环/地形/建筑/植被/路径的前中后景建立空间层次",
      "粉色果冻主题使用受控高光，保留物体轮廓与色彩，不允许大片纯白过曝",
      "建筑、树木、植物和生物必须由复合几何或经许可的本地资产形成可辨认形体"
    ]
  },
  "theme": {
    "styleId": "neumorph-blossom",
    "background": "#fff5f8",
    "surface": "#ffffff",
    "text": "#352735",
    "muted": "#765f70",
    "accent": "#cf6291",
    "accentSoft": "#f7dce8",
    "fontMood": "serif",
    "density": "comfortable",
    "radius": "rounded"
  },
