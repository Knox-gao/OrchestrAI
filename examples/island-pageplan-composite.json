      "children": [
        {
          "id": "notes-list",
          "type": "list",
          "items": [
            {
              "title": "材质是风格化高光",
              "text": "果冻质感由受控高光与色彩压缩表现，不是物理精确折射。"
            },
            {
              "title": "没有阴影贴图",
              "text": "接触感来自聚合成片的软阴影盘，不是 shadow mapping。"
            },
            {
              "title": "几何是程序化的",
              "text": "所有物件由内置网格生成器构建，不支持导入外部 3D 模型。"
            }
          ]
        }
      ]
    }
